# Database
DATABASE_URL="postgresql://user:password@localhost:5432/stickers_predictor"

# Server
PORT=3000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5500

# JWT
JWT_SECRET=your-secure-random-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Mailgun (for transactional emails)
MAILGUN_DOMAIN=mg.yourdomain.com
MAILGUN_API_KEY=key-...
MAILGUN_FROM_EMAIL=noreply@yourdomain.com

# Business
BUSINESS_NAME="Stickers Predictor"
BUSINESS_EMAIL=support@stickers-predictor.com
BUSINESS_SUPPORT_URL=https://support.stickers-predictor.com

# Feature flags
FEATURE_STRIPE_ENABLED=true
FEATURE_EMAIL_ENABLED=true
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_TIME=900000
